cabal-version: 3.0
name:          toxcore-android
synopsis:      A Tox client for Android, in Haskell
version:       0.1.0
license:       GPL-3.0-only
build-type:    Simple
author:        iphy
maintainer:    iphy
copyright:     Copyright (c) 2026 The TokTok Team
homepage:      https://toktok.ltd
category:      Network

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  exposed-modules:
    Tox.Android.App
    Tox.Android.Avatars
    Tox.Android.Emoji
    Tox.Android.Export
    Tox.Android.Files
    Tox.Android.Formats
    Tox.Android.Identicon
    Tox.Android.Import
    Tox.Android.Linked
    Tox.Android.Links
    Tox.Android.Locations
    Tox.Android.Messages
    Tox.Android.Model
    Tox.Android.Network
    Tox.Android.Nodes
    Tox.Android.Outgoing
    Tox.Android.Pictures
    Tox.Android.Qoi
    Tox.Android.Png
    Tox.Android.QrCode
    Tox.Android.Relays
    Tox.Android.Store
    Tox.Android.Theme
    Tox.Android.Version
    Tox.Android.View
  build-depends:
      base               <5
    , base16-bytestring  >=1
    , binary
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , filepath
    , hatter
    , monad-logger
    , qrcode-core
    , saltine
    , sqlite-simple
    , text
    , time
    , toxav
    , toxcore
    , toxcore-sync
    , vector

test-suite testsuite
  default-language:   Haskell2010
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  ghc-options:        -Wall
  main-is:            testsuite.hs
  other-modules:
    Tox.Android.EmojiSpec
    Tox.Android.ExportSpec
    Tox.Android.FilesSpec
    Tox.Android.FormatsSpec
    Tox.Android.IdenticonSpec
    Tox.Android.LinkedSpec
    Tox.Android.LinksSpec
    Tox.Android.LocationsSpec
    Tox.Android.MessagesSpec
    Tox.Android.NodesSpec
    Tox.Android.QoiSpec
    Tox.Android.RelaysSpec
    Tox.Android.ModelSpec
    Tox.Android.Sample
    Tox.Android.StoreSpec
    Tox.Android.ViewSpec
  build-depends:
      base               <5
    , base16-bytestring  >=1
    , binary
    , bytestring
    , containers
    , hatter
    , hspec
    , QuickCheck
    , saltine
    , sqlite-simple
    , text
    , time
    , toxcore
    , toxcore-android
    , toxcore-sync
    , vector
