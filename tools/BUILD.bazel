[sh_test(
    name = "c_interop_%s_test" % mode.replace("-", "_"),
    size = "large" if mode in ["file-tcp", "restart", "group3", "group3-c", "group-restart", "group-reload", "public-group-tcp", "hs-public-group-tcp"] else "medium",
    srcs = ["c-interop-test.sh"],
    args = [
        "$(location :tox-c-peer)",
        "$(location :tox-dht-node)",
