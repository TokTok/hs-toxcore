cabal-version: 3.0
name:          toxcore-sync
synopsis:      Account sync between a Tox user's devices
version:       0.1.0
license:       GPL-3.0-only
license-file:  LICENSE
build-type:    Simple
author:        iphy
maintainer:    iphy
copyright:     Copyright (c) 2026 The TokTok Team
homepage:      https://toktok.ltd
category:      Network

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  exposed-modules:
    Tox.Sync.Account
    Tox.Sync.Event
    Tox.Sync.Fact
    Tox.Sync.Frame
    Tox.Sync.Id
    Tox.Sync.MessagePack
    Tox.Sync.Pairing
    Tox.Sync.Protocol
    Tox.Sync.Replica
    Tox.Sync.Session
    Tox.Sync.Setting
    Tox.Sync.Store
  build-depends:
      base               <5
    , base16-bytestring
    , bytestring
    , containers
    , cryptohash-sha256
    , text

test-suite testsuite
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  hs-source-dirs:   test
  main-is:          testsuite.hs
  ghc-options:      -Wall
  other-modules:
    Tox.Sync.ConformanceSpec
  build-depends:
      aeson
    , base               <5
    , base16-bytestring
    , bytestring
    , containers
    , hspec
    , scientific
    , text
    , toxcore-sync
    , vector
